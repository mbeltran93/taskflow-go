{
  "info": {
    "name": "TaskFlow API (Go)",
    "description": "Flujo completo + casos de error contra la API de taskflow-go.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "ownerId", "value": "" },
    { "key": "assigneeId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "Flujo completo",
      "item": [
        {
          "name": "1. Registrar owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('ownerId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Owner\",\n  \"email\": \"owner@example.com\",\n  \"password\": \"supersecret\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "2. Registrar assignee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('assigneeId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Assignee\",\n  \"email\": \"assignee@example.com\",\n  \"password\": \"supersecret\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "3. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('token presente', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"supersecret\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "4. Crear proyecto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('projectId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Launch\",\n  \"description\": \"Q4 launch\",\n  \"ownerId\": {{ownerId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        },
        {
          "name": "5. Crear tarea",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('status inicial TODO', () => pm.expect(body.status).to.eql('TODO'));",
                  "pm.collectionVariables.set('taskId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write docs\",\n  \"description\": \"API docs\",\n  \"projectId\": {{projectId}},\n  \"assigneeId\": {{assigneeId}},\n  \"dueDate\": \"2026-12-31\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "6. Get tarea por id",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
          }
        },
        {
          "name": "7. Cambiar status a IN_PROGRESS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status actualizado', () => pm.expect(body.status).to.eql('IN_PROGRESS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}", "status"] }
          }
        },
        {
          "name": "8. Listar tareas filtradas (projectId + status)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('solo la tarea filtrada', () => pm.expect(body.length).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?projectId={{projectId}}&status=IN_PROGRESS",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "projectId", "value": "{{projectId}}" },
                { "key": "status", "value": "IN_PROGRESS" }
              ]
            }
          }
        },
        {
          "name": "9. Borrar tarea",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('204 sin contenido', () => pm.response.to.have.status(204));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
          }
        }
      ]
    },
    {
      "name": "Casos de error",
      "item": [
        {
          "name": "Crear proyecto sin token -> 401",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('401 sin autorizar', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sin token\",\n  \"ownerId\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        },
        {
          "name": "Get proyecto inexistente -> 404",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('404 no encontrado', () => pm.response.to.have.status(404));"] }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/projects/999999", "host": ["{{baseUrl}}"], "path": ["api", "projects", "999999"] }
          }
        },
        {
          "name": "Login con credenciales invalidas -> 401",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('401 sin autorizar', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"wrongpassword\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Registrar email duplicado -> 409",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('409 conflicto', () => pm.response.to.have.status(409));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicado\",\n  \"email\": \"owner@example.com\",\n  \"password\": \"supersecret\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        }
      ]
    }
  ]
}
